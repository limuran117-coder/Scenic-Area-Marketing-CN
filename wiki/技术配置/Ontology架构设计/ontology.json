{
  "schema": "电影小镇-Ontology-v1",
  "version": "1.1.3",
  "createdAt": "2026-05-29",
  "updatedAt": "2026-06-04",
  "authorityHierarchyVersion": "1.0",
  "description": "电影小镇运营决策系统的领域本体——对标 Palantir Ontology 架构",
  "objectTypes": {
    "ScenicSpot": {
      "description": "景区实体。电影小镇及所有竞品/对标景区",
      "properties": {
        "id": {
          "type": "string",
          "key": true
        },
        "name": {
          "type": "string"
        },
        "shortName": {
          "type": "string"
        },
        "category": {
          "type": "enum",
          "values": [
            "theme_park",
            "historical",
            "nature",
            "cultural_town"
          ]
        },
        "location": {
          "type": "string"
        },
        "tier": {
          "type": "enum",
          "values": [
            "primary",
            "secondary",
            "national"
          ]
        },
        "annualCapacity": {
          "type": "number",
          "unit": "万人"
        },
        "isCoreCompetitor": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "date"
        },
        "updatedAt": {
          "type": "date"
        }
      },
      "linkTypes": [
        "competes_with",
        "located_in",
        "has_campaign",
        "has_content",
        "has_metric"
      ],
      "dataSources": [
        "douyin_index_v9.py",
        "xiaohongshu_crawl.py",
        "competitor_program_tracker.py"
      ]
    },
    "MetricSnapshot": {
      "description": "景区数据快照——搜索指数、综合指数、客流等每日/每周度量",
      "properties": {
        "id": {
          "type": "string",
          "key": true
        },
        "scenicSpotId": {
          "type": "string",
          "ref": "ScenicSpot"
        },
        "date": {
          "type": "date"
        },
        "source": {
          "type": "enum",
          "values": [
            "douyin",
            "xiaohongshu",
            "weibo",
            "baidu",
            "internal_csv"
          ]
        },
        "metricType": {
          "type": "enum",
          "values": [
            "search_index",
            "composite_index",
            "visitor_count",
            "revenue",
            "content_count",
            "engagement_rate"
          ]
        },
        "value": {
          "type": "number"
        },
        "dailyChange": {
          "type": "number",
          "optional": true
        },
        "weeklyChange": {
          "type": "number",
          "optional": true
        },
        "confidence": {
          "type": "number",
          "optional": true,
          "description": "数据置信度 0-1"
        },
        "collectedAt": {
          "type": "datetime"
        }
      },
      "linkTypes": [
        "belongs_to",
        "aggregated_from"
      ],
      "dataSources": [
        "adapter-douyin.py::/tmp/crawl_data.json",
        "adapter-xiaohongshu.py::/tmp/xiaohongshu_*.json",
        "adapter-visitors.py::~/Desktop/2026游客量统计.csv",
        "adapter-baidu.py::/tmp/baidu_index.json (PARTIAL: CDP可行, 覆盖率12.5%)",
        "ontology_query.py::预定义查询引擎"
      ],
      "notes": "Day6百度实测(2026-06-04): 8景区仅清明上河园有数据,覆盖率12.5%; CDP浏览器采集可行;其余关键词未收录/低于阈值"
    },
    "ContentAsset": {
      "description": "内容资产——抖音视频、小红书笔记、微博等所有营销内容",
      "properties": {
        "id": {
          "type": "string",
          "key": true
        },
        "title": {
          "type": "string"
        },
        "platform": {
          "type": "enum",
          "values": [
            "douyin",
            "xiaohongshu",
            "weibo",
            "bilibili",
            "other"
          ]
        },
        "type": {
          "type": "enum",
          "values": [
            "video",
            "note",
            "post",
            "live",
            "kol_collab"
          ]
        },
        "url": {
          "type": "string",
          "optional": true
        },
        "authorId": {
          "type": "string",
          "optional": true
        },
        "authorName": {
          "type": "string",
          "optional": true
        },
        "publishDate": {
          "type": "date"
        },
        "views": {
          "type": "number",
          "optional": true
        },
        "likes": {
          "type": "number",
          "optional": true
        },
        "comments": {
          "type": "number",
          "optional": true
        },
        "shares": {
          "type": "number",
          "optional": true
        },
        "sentiment": {
          "type": "enum",
          "values": [
            "positive",
            "neutral",
            "negative",
            "mixed"
          ],
          "optional": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "optional": true
        },
        "isViral": {
          "type": "boolean",
          "optional": true
        },
        "collectedAt": {
          "type": "datetime"
        }
      },
      "linkTypes": [
        "mentions",
        "promotes",
        "triggers_sentiment",
        "contributes_to"
      ],
      "dataSources": [
        "adapter-xiaohongshu.py (预留: 爬虫升级后启用详细笔记)",
        "seed_content_assets.py (种子数据: 8条代表性内容)",
        "competitor_program_tracker.py"
      ]
    },
    "Event": {
      "description": "事件/动态——竞品活动、行业趋势、舆情事件、政策变化",
      "properties": {
        "id": {
          "type": "string",
          "key": true
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "enum",
          "values": [
            "competitor_activity",
            "industry_trend",
            "sentiment_incident",
            "policy_change",
            "seasonal_peak",
            "other"
          ]
        },
        "severity": {
          "type": "enum",
          "values": [
            "info",
            "watch",
            "warning",
            "critical"
          ]
        },
        "description": {
          "type": "text"
        },
        "source": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "optional": true
        },
        "occurredAt": {
          "type": "datetime"
        },
        "detectedAt": {
          "type": "datetime"
        },
        "expiresAt": {
          "type": "datetime",
          "optional": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "optional": true
        }
      },
      "linkTypes": [
        "affects",
        "mentioned_in"
      ],
      "dataSources": [
        "舆情监控",
        "文旅情报日报",
        "竞品内容动态"
      ]
    },
    "MarketingCampaign": {
      "description": "营销活动——促销、达人合作、节日活动等",
      "properties": {
        "id": {
          "type": "string",
          "key": true
        },
        "name": {
          "type": "string"
        },
        "scenicSpotId": {
          "type": "string",
          "ref": "ScenicSpot"
        },
        "type": {
          "type": "enum",
          "values": [
            "seasonal_event",
            "price_promotion",
            "kol_collab",
            "brand_merge",
            "social_media",
            "other"
          ]
        },
        "budget": {
          "type": "number",
          "optional": true,
          "unit": "元"
        },
        "startDate": {
          "type": "date"
        },
        "endDate": {
          "type": "date",
          "optional": true
        },
        "targetAudience": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "optional": true
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "optional": true
        },
        "expectedImpact": {
          "type": "string",
          "optional": true
        },
        "actualImpact": {
          "type": "string",
          "optional": true
        },
        "status": {
          "type": "enum",
          "values": [
            "planned",
            "active",
            "completed",
            "cancelled"
          ]
        }
      },
      "linkTypes": [
        "belongs_to",
        "targets",
        "uses"
      ],
      "dataSources": [
        "电影小镇营销日历",
        "竞品内容动态"
      ]
    },
    "DecisionRule": {
      "description": "决策规则——已验证和经验证的运营判断准则",
      "properties": {
        "id": {
          "type": "string",
          "key": true
        },
        "ruleId": {
          "type": "string",
          "description": "如 R-001"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "enum",
          "values": [
            "content_strategy",
            "pricing",
            "alert",
            "competitive_response",
            "timing"
          ]
        },
        "condition": {
          "type": "text",
          "description": "触发条件逻辑"
        },
        "action": {
          "type": "text",
          "description": "触发的动作"
        },
        "authorityTier": {
          "type": "number",
          "optional": true,
          "description": "宪法VII优先级：1=宪法/2=站长指令/3=规程/4=规则/5=项目指令/6=证据/7=记忆/8=人格/9=先例。低数字=高优先级"
        },
        "conflictRule": {
          "type": "enum",
          "values": [
            "higher_tier_wins",
            "specific_overrides_general",
            "latest_wins",
            "user_override",
            "never_override"
          ],
          "optional": true,
          "description": "当多个规则冲突时的解决策略"
        },
        "confidence": {
          "type": "number",
          "description": "验证置信度 0-1"
        },
        "status": {
          "type": "enum",
          "values": [
            "hypothesis",
            "verified",
            "invalidated",
            "obsolete"
          ]
        },
        "source": {
          "type": "string",
          "description": "来源：数据驱动/专家经验/案例学习"
        },
        "lastTriggeredAt": {
          "type": "datetime",
          "optional": true
        },
        "triggerCount": {
          "type": "number",
          "optional": true
        }
      },
      "linkTypes": [
        "triggers_action",
        "based_on_metric",
        "overridden_by"
      ],
      "dataSources": [
        "wiki/行业知识/决策规则库.md"
      ]
    },
    "OntologyAdapter": {
      "description": "Ontology Adapter——原始数据到 Ontology 对象的转换器",
      "properties": {
        "id": {
          "type": "string",
          "key": true
        },
        "name": {
          "type": "string",
          "description": "如 adapter-douyin.py"
        },
        "sourceFormat": {
          "type": "string",
          "description": "输入数据格式描述"
        },
        "targetObjectType": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "生成的 Ontology ObjectType"
        },
        "confidence": {
          "type": "number",
          "description": "该适配器的默认数据置信度 0-1"
        },
        "status": {
          "type": "enum",
          "values": [
            "active",
            "partial",
            "pending"
          ]
        },
        "lastRunAt": {
          "type": "datetime",
          "optional": true
        },
        "outputPath": {
          "type": "string",
          "description": "输出到 data/ 的路径模式"
        }
      },
      "linkTypes": [
        "transforms_to"
      ],
      "dataSources": []
    },
    "AgentTask": {
      "description": "Agent 定时任务——cron 调度的所有自动化工作流",
      "properties": {
        "id": {
          "type": "string",
          "key": true
        },
        "name": {
          "type": "string",
          "description": "如 抖音指数日报"
        },
        "cronJobId": {
          "type": "string",
          "optional": true
        },
        "schedule": {
          "type": "string",
          "description": "cron 表达式"
        },
        "type": {
          "type": "enum",
          "values": [
            "data_collection",
            "analysis",
            "report_generation",
            "knowledge_archiving",
            "system_maintenance"
          ]
        },
        "status": {
          "type": "enum",
          "values": [
            "active",
            "paused",
            "failed",
            "pending"
          ]
        },
        "lastRunAt": {
          "type": "datetime",
          "optional": true
        },
        "lastRunStatus": {
          "type": "enum",
          "values": [
            "ok",
            "error",
            "timeout",
            "skipped"
          ],
          "optional": true
        },
        "lastDurationMs": {
          "type": "number",
          "optional": true
        },
        "consecutiveErrors": {
          "type": "number",
          "optional": true
        },
        "outputTo": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "optional": true,
          "description": "输出目标：wiki/飞书/Storage"
        }
      },
      "linkTypes": [
        "writes_to",
        "triggered_by"
      ],
      "dataSources": [
        "cron list"
      ]
    }
  },
  "linkTypes": {
    "competes_with": {
      "description": "竞品关系（many-to-many）",
      "sourceTypes": [
        "ScenicSpot"
      ],
      "targetTypes": [
        "ScenicSpot"
      ],
      "properties": {
        "strength": {
          "type": "enum",
          "values": [
            "direct",
            "indirect",
            "regional"
          ]
        },
        "overlapAudience": {
          "type": "number",
          "optional": true,
          "description": "客群重叠度 0-1"
        }
      }
    },
    "belongs_to": {
      "description": "从属关系（many-to-one）",
      "sourceTypes": [
        "MetricSnapshot",
        "MarketingCampaign"
      ],
      "targetTypes": [
        "ScenicSpot"
      ],
      "properties": {}
    },
    "transforms_to": {
      "description": "Adapter 转换数据到 Ontology Object",
      "sourceTypes": [
        "OntologyAdapter"
      ],
      "targetTypes": [
        "MetricSnapshot",
        "ContentAsset"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "optional": true,
          "description": "转换置信度"
        }
      }
    },
    "mentions": {
      "description": "内容提及景区",
      "sourceTypes": [
        "ContentAsset"
      ],
      "targetTypes": [
        "ScenicSpot"
      ],
      "properties": {
        "relevance": {
          "type": "number",
          "optional": true,
          "description": "相关性 0-1"
        }
      }
    },
    "affects": {
      "description": "事件影响景区",
      "sourceTypes": [
        "Event"
      ],
      "targetTypes": [
        "ScenicSpot"
      ],
      "properties": {
        "impactLevel": {
          "type": "enum",
          "values": [
            "high",
            "medium",
            "low",
            "none"
          ]
        }
      }
    },
    "triggers_action": {
      "description": "规则触发动作",
      "sourceTypes": [
        "DecisionRule"
      ],
      "targetTypes": [
        "AgentTask",
        "Event"
      ],
      "properties": {
        "urgency": {
          "type": "enum",
          "values": [
            "immediate",
            "today",
            "this_week",
            "not_urgent"
          ]
        }
      }
    },
    "based_on_metric": {
      "description": "决策规则基于数据度量",
      "sourceTypes": [
        "DecisionRule"
      ],
      "targetTypes": [
        "MetricSnapshot"
      ],
      "properties": {
        "threshold": {
          "type": "number",
          "optional": true
        }
      }
    },
    "promotes": {
      "description": "营销活动推广的内容",
      "sourceTypes": [
        "MarketingCampaign"
      ],
      "targetTypes": [
        "ContentAsset"
      ],
      "properties": {}
    },
    "targets": {
      "description": "活动/内容瞄准的客群",
      "sourceTypes": [
        "MarketingCampaign"
      ],
      "targetTypes": [
        "TouristSegment"
      ],
      "properties": {}
    },
    "triggered_by": {
      "description": "Agent 任务由何触发",
      "sourceTypes": [
        "AgentTask"
      ],
      "targetTypes": [
        "Event",
        "DecisionRule"
      ],
      "properties": {}
    },
    "aggregated_from": {
      "description": "数据快照由哪些内容资产聚合生成（M:1 正向引用）",
      "sourceTypes": [
        "MetricSnapshot"
      ],
      "targetTypes": [
        "ContentAsset"
      ],
      "properties": {
        "contributionRatio": {
          "type": "number",
          "optional": true,
          "description": "该资产对快照值的贡献比例 0-1"
        }
      }
    },
    "contributes_to": {
      "description": "内容资产贡献了哪个数据快照（1:M 反向引用）",
      "sourceTypes": [
        "ContentAsset"
      ],
      "targetTypes": [
        "MetricSnapshot"
      ],
      "properties": {
        "contributionType": {
          "type": "enum",
          "values": [
            "engagement",
            "reach",
            "conversion"
          ],
          "optional": true
        }
      }
    },
    "writes_to": {
      "description": "Agent 任务输出到知识库",
      "sourceTypes": [
        "AgentTask"
      ],
      "targetTypes": [
        "KnowledgeBase"
      ],
      "properties": {}
    },
    "located_in": {
      "description": "景区位于区域",
      "sourceTypes": [
        "ScenicSpot"
      ],
      "targetTypes": [
        "Region"
      ],
      "properties": {}
    }
  },
  "functions": {
    "calculateSearchTrend": {
      "name": "搜索指数趋势计算",
      "input": "ScenicSpot.id, dateRange",
      "output": "trend_line: [{date, searchIndex, compositeIndex}]",
      "source": "douyin_index_v9.py",
      "schedule": "daily 11:00"
    },
    "assessContentVacuum": {
      "name": "内容缺口判定",
      "input": "searchIndex, compositeIndex",
      "output": "vacuumLevel: 'open'|'closing'|'none', recommendation",
      "source": "MEMORY.md/#内容真空窗口",
      "schedule": "daily after metric collection"
    },
    "predictVisitorFlow": {
      "name": "客流预测",
      "input": "historicalVisitorData, weather, holidayCalendar, recentSearchTrend",
      "output": "predictedVisitorCount, confidence",
      "source": "period.js (算法模式)",
      "schedule": "weekly (周二)"
    },
    "sentimentAnalysis": {
      "name": "舆情情感分析",
      "input": "ContentAsset[platform, text, engagement]",
      "output": "sentimentScore, topNegativeKeywords, alertLevel",
      "source": "舆情监控任务",
      "schedule": "daily 16:00"
    },
    "attributionScore": {
      "name": "营销归因评分",
      "input": "campaignTimeline, visitorData, metricChanges",
      "output": "attribution: {campaignId, score, confidence}",
      "source": "营销效果归因任务",
      "schedule": "daily 07:00"
    },
    "competitiveAlert": {
      "name": "竞品异动预警",
      "input": "ScenicSpot[], recentEvents",
      "output": "alerts[{competitor, event, impact, urgency}]",
      "source": "竞品内容动态/竞品关键词深度分析",
      "schedule": "daily 14:00"
    },
    "generateDailyInsight": {
      "name": "每日洞察生成",
      "input": "all today's MetricSnapshots + Events + ContentAssets",
      "output": "insightCards[{type, headline, data, recommendation, confidence}]",
      "source": "每日复盘整合任务",
      "schedule": "daily 22:00"
    }
  },
  "actions": {
    "SendFeishuCard": {
      "description": "发送飞书卡片到电影小镇群",
      "input": "chatId, cardJson",
      "governance": {
        "requiresApproval": false,
        "auditLog": true,
        "rateLimit": "per minute"
      },
      "callingTasks": [
        "抖音指数日报",
        "小红书日报",
        "文旅情报日报",
        "竞品内容动态",
        "竞品关键词深度分析",
        "竞品爆款拆解",
        "每日复盘整合",
        "周度竞争格局报告",
        "电影小镇营销日历",
        "周度客流洞察"
      ]
    },
    "UpdateWiki": {
      "description": "写入/更新 wiki 知识库",
      "input": "path, content",
      "governance": {
        "requiresApproval": false,
        "auditLog": true,
        "allowedPaths": [
          "wiki/"
        ]
      },
      "callingTasks": [
        "营销效果归因",
        "文旅情报日报(wiki沉淀)",
        "案例库更新",
        "Ontology架构研究"
      ]
    },
    "CreateAlert": {
      "description": "创建预警——发送私信给站长",
      "input": "severity, title, detail, suggestedAction",
      "governance": {
        "requiresApproval": false,
        "auditLog": true,
        "onlyOwner": true
      },
      "callingTasks": [
        "舆情监控",
        "CDP健康探针(异常时)"
      ]
    },
    "UpdateDecisionRule": {
      "description": "更新决策规则状态",
      "input": "ruleId, newStatus, verificationEvidence",
      "governance": {
        "requiresApproval": true,
        "auditLog": true
      },
      "callingTasks": [
        "周度竞争格局报告(学习闭环)",
        "每日复盘整合(验证记录)"
      ]
    },
    "ScheduleOntologyResearch": {
