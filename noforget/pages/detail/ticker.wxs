// pages/detail/ticker.wxs — WXS 视图层倒计时计算
// 在视图层原生执行，零逻辑层通信开销
// JS 层只需传入 _nextTargetEndMs（目标日次日00:00的时间戳）

function pad(n) {
  return n < 10 ? '0' + n : '' + n
}

function getHms(targetEndMs) {
  if (!targetEndMs || targetEndMs <= 0) {
    return '00:00:00'
  }
  // 目标日次日00:00毫秒时间戳
  var target = getDate(targetEndMs)
  if (!target.getTime || isNaN(target.getTime())) {
    return '00:00:00'
  }
  var diffMs = target.getTime() - getDate().getTime()
  if (diffMs <= 0) {
    return '00:00:00'
  }
  var totalSec = Math.floor(diffMs / 1000)
  var h = Math.floor(totalSec / 3600) % 24
  var m = Math.floor(totalSec / 60) % 60
  var s = totalSec % 60
  return pad(h) + ':' + pad(m) + ':' + pad(s)
}

module.exports = {
  getHms: getHms
}
